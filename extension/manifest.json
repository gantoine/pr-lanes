{
  "manifest_version": 3,
  "name": "PR Lanes for GitHub",
  "version": "0.1.0",
  "description": "Splits GitHub pull request conversations into two switchable lanes: human discussion and bot noise.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content/classify.js", "content/lanes.js"],
      "css": ["content/lanes.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["options/options.html", "options/options.css", "options/options.js"],
      "matches": ["https://github.com/*"]
    }
  ]
}
