# Firefox add-on signing, used by `npm run sign:firefox`.
# Create a key pair at https://addons.mozilla.org/developers/addon/api/key/
# then copy this file to .env (gitignored) and paste the real values in.
WEB_EXT_API_KEY=user:12345678:901
WEB_EXT_API_SECRET=

# Chrome Web Store publishing, used by `npm run publish:chrome`.
# The item id is the 32-letter string in the Web Store listing URL; the rest come
# from a Google Cloud OAuth client with the Chrome Web Store API enabled.
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
